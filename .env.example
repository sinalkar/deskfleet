# ── LLM ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=                      # blank = OpenAI; set for Groq/OpenAI-compatible swap

# ── LangSmith tracing ────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=deskfleet
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── External order API ───────────────────────────
FAKESTORE_BASE_URL=https://fakestoreapi.com
HTTP_TIMEOUT_SECONDS=10

# ── Agent behavior ───────────────────────────────
MAX_REVIEW_ITERATIONS=2
TEMPERATURE=0.2
MAX_TOOL_ROUNDS=3

# ── Storage ──────────────────────────────────────
SQLITE_PATH=./deskfleet.db

# ── Service ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

# ── UI ───────────────────────────────────────────
API_URL=http://localhost:8080     # Streamlit → API
