# ── LLM ──────────────────────────────────────────
# Provider: openai | groq | gemini | nvidia | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini              # provider-specific model id, e.g.:
                                   #   groq      -> llama-3.3-70b-versatile
                                   #   gemini    -> gemini-2.0-flash
                                   #   nvidia    -> meta/llama-3.1-70b-instruct
                                   #   anthropic -> claude-sonnet-4-6
                                   #   ollama    -> llama3.1:8b
LLM_BASE_URL=                      # optional override for OpenAI-compatible providers

# ── Per-provider keys (fill only what you use) ───
OPENAI_API_KEY=sk-...
GROQ_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1   # no key needed for Ollama

# ── LangSmith tracing ────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=deskfleet
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── External order API ───────────────────────────
FAKESTORE_BASE_URL=https://fakestoreapi.com
HTTP_TIMEOUT_SECONDS=10

# ── Agent behavior ───────────────────────────────
MAX_REVIEW_ITERATIONS=2
TEMPERATURE=0.2
MAX_TOOL_ROUNDS=3

# ── Storage ──────────────────────────────────────
SQLITE_PATH=./deskfleet.db

# ── Service ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

# ── UI ───────────────────────────────────────────
API_URL=http://localhost:8080     # Streamlit → API
